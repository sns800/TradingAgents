# LLM 제공자 API 키 (사용하는 것 하나만 채우면 됩니다)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# FRED (미국 연방준비은행 거시경제 데이터: 금리, 인플레이션, 고용, 성장).
# 무료 키 발급: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# 선택: 사용자 지정 OpenAI 호환 엔드포인트 (vLLM, LM Studio, llama.cpp, 릴레이 등).
# 제공자로 "openai_compatible"을 선택하고 base URL을 설정하세요.
# 키는 선택 사항입니다 (로컬 서버는 키가 필요 없음).
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (제공자 "bedrock", 설치: pip install ".[bedrock]").
# 인증 방법: Bedrock API 키(bearer 토큰, AWS 액세스 키 불필요) 또는
# AWS 자격 증명 체인(환경변수 키 / ~/.aws/credentials / IAM 역할 / AWS_PROFILE) 중 하나.
# 어느 방법이든 리전(region)은 설정해야 하며, 둘 다 있으면 bearer 토큰이 우선합니다.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# 선택: 원격 Ollama 서버 주소. 설정하지 않으면 로컬 인스턴스
# (http://localhost:11434/v1)를 기본으로 사용합니다. Ollama 생태계의
# 일반적인 관례를 따르며, CLI 드롭다운과 프로그래밍 방식 클라이언트
# 모두 이 값을 읽습니다.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# 선택: 코드 수정 없이 DEFAULT_CONFIG를 덮어쓰기.
# 아래 TRADINGAGENTS_* 변수를 설정하면 tradingagents/default_config.py의
# 해당 키를 대체합니다. 값은 기존 기본값의 타입(bool / int / str)으로
# 자동 변환되므로 "true"나 "3"처럼 쓰면 됩니다.
# CLI에서는 LLM 제공자 / 모델 / backend URL / 언어를 설정해두면
# 해당 대화형 선택 단계를 건너뜁니다 (opencode, LM Studio 같은
# OpenAI 호환 엔드포인트나 무인 실행에 유용).
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
# 분석 리포트 출력 언어. "Korean"으로 설정하면 모든 보고서가 한국어로 생성됩니다.
#TRADINGAGENTS_OUTPUT_LANGUAGE=Korean
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# 샘플링 온도(temperature). 낮을수록 이를 지원하는 모델에서 실행 간 편차가
# 줄어듭니다. 설정하지 않으면 각 제공자의 기본값을 사용합니다. README의
# "재현성(Reproducibility)" 항목 참고 — 어떤 설정도 LLM 출력을 완전히
# 결정적으로 만들지는 못합니다.
#TRADINGAGENTS_TEMPERATURE=0.0
# 모든 제공자에 전달되는 LLM SDK 재시도 횟수. 설정하지 않으면 각 SDK의
# 기본값(보통 2)을 사용합니다. 요청 제한이 있는 배포 환경(예: Azure OpenAI)에서
# 429 rate-limit이 몰릴 때 실행을 중단하지 않고 버티려면 값을 올리세요.
#TRADINGAGENTS_LLM_MAX_RETRIES=6
# 제공자별 추론(reasoning/thinking) 깊이 (선택; 미설정 시 제공자 기본값).
# 설정하면 해당 대화형 질문도 건너뜁니다.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
